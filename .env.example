# Copy this file to `.env`.
# Do not commit `.env`.

###############################################################################
# 1. Backend
###############################################################################

# `agy` uses Antigravity CLI directly.
# `opencode` uses OpenCode and routes web search through the local agy wrapper.
AGENT_BACKEND=agy

###############################################################################
# 2. Antigravity / agy
###############################################################################

# Host path to the agy binary. Required for Docker because compose mounts it.
# Check with: command -v agy
AGY_BIN=/home/your-user/.local/bin/agy

# Host agy auth/config directory. Usually ~/.gemini after login.
AGY_HOME=/home/your-user/.gemini

# Command name/path used inside run.sh.
# Docker should usually keep this as `agy`.
AGY_COMMAND=agy

###############################################################################
# 3. OpenCode
###############################################################################

# Command name/path used inside run.sh.
# Docker should usually keep this as `opencode`.
OPENCODE_COMMAND=opencode

# Host path to the OpenCode binary. Required for Docker because compose mounts it.
# Prefer the real binary path, not an npm symlink:
#   readlink -f "$(command -v opencode)"
OPENCODE_BIN=/home/your-user/.npm-global/lib/node_modules/opencode-ai/bin/opencode.exe

# Project default OpenCode model and agent.
OPENCODE_MODEL=openai/gpt-5.4-mini
OPENCODE_AGENT=market-reporter

# Extra args passed to `opencode run`; normally leave blank.
OPENCODE_RUN_ARGS=

# Override OpenCode config paths only when needed.
# Leave blank to use repository-local opencode.json and .opencode/.
OPENCODE_CONFIG=
OPENCODE_CONFIG_DIR=

###############################################################################
# 4. OpenCode Auth For Docker
###############################################################################

# Use one of these auth methods:
# - Set OPENAI_API_KEY below.
# - Or run `opencode auth login` on the host and mount the host auth dirs.

# Leave blank to use the standard host paths:
#   ~/.config/opencode
#   ~/.local/share/opencode
#   ~/.local/state/opencode
#   ~/.cache/opencode
OPENCODE_CONFIG_HOME=
OPENCODE_DATA_HOME=
OPENCODE_STATE_HOME=
OPENCODE_CACHE_HOME=

###############################################################################
# 5. Provider Keys
###############################################################################

# OPENAI_API_KEY is required when OpenCode uses OpenAI via API-key auth.
# GOOGLE_API_KEY / GEMINI_API_KEY are optional passthroughs for agy setups.
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=

###############################################################################
# 6. Discord
###############################################################################

# Required only when SKIP_DISCORD_POST=0.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

###############################################################################
# 7. Run Control
###############################################################################

# all, review, report, validate, or post
RUN_PHASE=all

# Leave blank for Asia/Tokyo today/yesterday.
RUN_DATE=
PREVIOUS_DATE=

# Use 1 for dry runs that should generate files but not post to Discord.
SKIP_DISCORD_POST=0

# Keep validation enabled in normal use.
SKIP_ARTIFACT_VALIDATION=0

# Keep normalization enabled in normal use.
SKIP_ARTIFACT_NORMALIZATION=0

# Set to 1 only when you want RUN_PHASE=report to reuse existing generated artifacts.
KEEP_EXISTING_REPORT_ARTIFACTS=0

###############################################################################
# 8. Scheduler
###############################################################################

TZ=Asia/Tokyo

# 24-hour HH:MM in TZ. Multiple daily times can be comma-separated.
RUN_AT=07:30

# Set to 1 to run immediately when the scheduler starts, then continue on schedule.
RUN_ON_START=0

# Usually leave this as-is.
RUN_COMMAND=./run.sh
