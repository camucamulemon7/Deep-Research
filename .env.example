# Copy this file to `.env` and fill in local values before using Docker Compose.

# Required: host path to the Antigravity CLI agy binary.
# Check with: command -v agy
AGY_BIN=/home/your-user/.local/bin/agy

# Required: host directory where Antigravity CLI stores authentication/config.
# Usually ~/.gemini after completing agy authentication on the host.
AGY_HOME=/home/your-user/.gemini

# Required for Discord posting at the end of run.sh.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Agent backend. Use `agy` for the existing flow or `opencode` for OpenCode.
AGENT_BACKEND=agy

# Optional: override backend commands if they are not on PATH.
AGY_COMMAND=agy
OPENCODE_COMMAND=opencode

# Optional OpenCode settings. Leave blank to use OpenCode defaults/config.
OPENCODE_MODEL=openai/gpt-5.4-mini
OPENCODE_AGENT=
OPENCODE_RUN_ARGS=
OPENCODE_CONFIG=
OPENCODE_CONFIG_DIR=

# Set to 1 for smoke tests that should generate files but not post to Discord.
SKIP_DISCORD_POST=0

# Optional workflow controls.
# RUN_PHASE can be all, review, report, or post.
RUN_PHASE=all

# Optional date overrides for reruns/backfills. Leave blank for Asia/Tokyo today/yesterday.
RUN_DATE=
PREVIOUS_DATE=

# Scheduler settings for the deep-research-scheduler service.
# Use 24-hour HH:MM in TZ. Multiple daily times can be comma-separated, e.g. RUN_AT=07:30,18:00.
TZ=Asia/Tokyo
RUN_AT=07:30

# Set to 1 to run immediately when the scheduler container starts, then continue on the schedule.
RUN_ON_START=0

# Usually leave this as-is.
RUN_COMMAND=./run.sh

# Optional: only set if your agy setup uses these environment variables.
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
