{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.4-mini",
  "autoupdate": false,
  "share": "disabled",
  "default_agent": "market-reporter",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "google_search": "deny"
  }
}
